# Supabase project (Project Settings → API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for invitations and admin provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used in invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional – transactional email. Without it, notifications stay in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# Secret for /api/cron/maintenance (Vercel sends it as a Bearer token). Generate a long random string.
CRON_SECRET=

# Optional – Web Push. Generate a pair with:  node scripts/generate-vapid.mjs
# The public key is shared with browsers; the private key is server-only. SUBJECT is a mailto: or https: contact.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# LOCAL ONLY (optional): sign in with just a name; only honoured when NEXT_PUBLIC_SUPABASE_URL is a local/private address.
# LOGIN_ID_DOMAIN=horti.test
