# Supabase project (Project Settings → API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for invitations and admin provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used in invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional – transactional email. Without it, notifications stay in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# Secret for /api/cron/maintenance (Vercel sends it as a Bearer token). Generate a long random string.
CRON_SECRET=
